// Hardware Hub — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ADMIN is the app owner — full control, including category structure and
 * shop settings. SHOP_OWNER is the business's own day-to-day operator: full
 * control over products, stock and orders, but not the category taxonomy or
 * the shop's legal/contact details. See requireAppOwner in middleware/auth.ts.
 */
enum Role {
  CUSTOMER
  SHOP_OWNER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/**
 * A user signs in with either email or phone, not necessarily both — so
 * both columns are nullable-but-unique. A CHECK constraint (added by hand in
 * the migration; Prisma has no declarative syntax for it) enforces that at
 * least one is always present, so a row can never end up unreachable by login.
 */
model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  passwordHash String
  phone        String?  @unique
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart   Cart?
  orders Order[]

  @@map("users")
}

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  parentId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  categoryId  String
  description String?
  // Money is stored as Decimal, never Float — no binary rounding drift on totals.
  price       Decimal  @db.Decimal(10, 2)
  stockQty    Int      @default(0)
  sku         String   @unique
  size        String?
  material    String?
  images      String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // One row per product per cart; quantity carries the count.
  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

/**
 * `orderNumber` is a human-facing order number — displayed as ODRH0000001
 * (see lib/orderNumber.ts). Backed by a Postgres SEQUENCE (order_number_seq,
 * created by hand in the migration since Prisma has no declarative syntax for
 * one), which is what makes it race-free: two checkouts finishing in the same
 * instant can never receive the same number, the same guarantee the
 * stock-decrement update relies on for concurrent buys. `id` remains the real
 * primary key and the one used for routing/API lookups — `orderNumber` exists
 * purely to be read by a human.
 */
model Order {
  id              String        @id @default(cuid())
  orderNumber     Int           @unique @default(dbgenerated("nextval('order_number_seq')"))
  userId          String
  status          OrderStatus   @default(PENDING)
  totalAmount     Decimal       @db.Decimal(10, 2)
  shippingAddress Json
  paymentStatus   PaymentStatus @default(PENDING)
  razorpayOrderId String?       @unique
  // Set together, only when an admin marks the order SHIPPED.
  trackingNumber  String?
  carrier         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  payments     Payment[]
  statusEvents OrderStatusEvent[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

/**
 * One row per status transition. `Order.status` only ever holds the current
 * state, so without this there is no way to answer "when was it shipped" or
 * show a tracking timeline — `updatedAt` gets overwritten by every change.
 */
model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  // e.g. "Order placed", "Shipped via BlueDart — AWB 7788221", "Stock restored"
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_events")
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  // Snapshot of the price when the order was placed — the product's price may change later.
  priceAtPurchase Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

/**
 * Single row holding the shop's own business details — name, GST, contact,
 * address. Enforced as a singleton by always reading/writing the fixed id
 * "singleton" rather than a separate lookup table; there is exactly one shop.
 * Shown publicly (footer, order pages) and editable only by an admin.
 */
model ShopSettings {
  id           String   @id @default("singleton")
  shopName     String
  gstNumber    String?
  phone        String
  email        String
  addressLine1 String
  city         String
  state        String
  pincode      String
  district     String?
  landmark     String?
  updatedAt    DateTime @updatedAt

  @@map("shop_settings")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  razorpayPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}
