# Copy to .env and fill in real values. .env is gitignored — never commit it.

NODE_ENV=development
PORT=4000

# Local PostgreSQL 18 (port 5433). Replace YOUR_PASSWORD with your postgres password.
# If the password has special characters, URL-encode them (@ -> %40, # -> %23).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/hardware_hub?schema=public"

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generate-with-node--require-crypto--randomBytes-48-toString-base64url
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Payments (Razorpay) ---
# Get TEST keys from https://dashboard.razorpay.com/app/website-app-settings/api-keys
# (switch the dashboard to Test Mode first — test key ids start with rzp_test_).
# Leave these unset and the catalogue, cart and orders still work; only the
# payment endpoints report 503. Switch to live keys only after a full test run.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
