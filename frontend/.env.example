# Copy to .env.local for local overrides. Vite only exposes VITE_-prefixed vars.

# Leave blank in dev — the Vite proxy forwards /api to http://localhost:4000.
# In production set this to your Render URL, e.g. https://hardware-hub-api.onrender.com
VITE_API_BASE_URL=

# Phase 5: Razorpay public key id (safe to expose; the secret stays server-side)
# VITE_RAZORPAY_KEY_ID=
